# Copiá este archivo como .env y completá los valores

# Base de datos MySQL de Hostinger
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_DB
DATABASE_URL="mysql://user:password@localhost:3306/compromisoparental"

# Clave secreta para el admin (cualquier string largo y aleatorio)
ADMIN_SECRET="cambia-esto-por-algo-seguro"

# Puerto (Hostinger Node.js suele asignarlo automáticamente via variable PORT)
PORT=3000

# Email SMTP de Hostinger (para enviar los materiales al inscribirse)
# Datos en hPanel → Emails → Configuración / Cuentas de email
# Host típico: smtp.hostinger.com · Puerto 465 (SSL) o 587 (STARTTLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="info@tudominio.com"
SMTP_PASS="la-contraseña-de-esa-casilla"
# Remitente que ve el destinatario (opcional, por defecto usa SMTP_USER)
SMTP_FROM="Compromiso Parental Avellaneda <info@tudominio.com>"
